# Koru environment variables template: real values are written only to .env; .env never enters the repo.

# Notification channel: ntfy
KORU_NTFY_URL=
KORU_NTFY_TOKEN=

# Notification channel: Telegram
KORU_TELEGRAM_BOT_TOKEN=
KORU_TELEGRAM_CHAT_ID=

# Notification channel: email (SMTP)
KORU_SMTP_HOST=
KORU_SMTP_PORT=
KORU_SMTP_USER=
KORU_SMTP_PASSWORD=
KORU_SMTP_FROM=
KORU_SMTP_TO=

# IP masking in notifications (IPv4 /24, IPv6 /48): empty or true/1/yes = on (the default), false/0/no = off.
# Full IPs stay only in the local store; notification channels are third parties (KVKK/GDPR).
KORU_NOTIFY_MASK_IP=

# Heartbeat: Healthchecks.io ping URL
KORU_HEARTBEAT_URL=

# Lab AI model: an OpenAI-compatible API (OpenAI or OpenRouter), for the isolated lab only
KORU_LAB_LLM_BASE_URL=
KORU_LAB_LLM_API_KEY=
KORU_LAB_LLM_MODEL=

# Release signing key and its password
KORU_SIGNING_KEY=
KORU_SIGNING_KEY_PASSWORD=

# Cloudflare: the promo site, the waitlist (D1), and Turnstile
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
TURNSTILE_SECRET_KEY=
