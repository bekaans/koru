#!/bin/sh
# Koru pre-push hook: changes land on main through pull requests, history is never rewritten.
# Bypass needs `git push --no-verify` and maintainer approval.

zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: rejected: direct pushes to main are not allowed; open a pull request." >&2
    status=1
    continue
  fi
  [ "$local_sha" = "$zero" ] && continue   # deleting a non-main branch is fine
  [ "$remote_sha" = "$zero" ] && continue  # new remote ref
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push: rejected: non-fast-forward push to $remote_ref (force push or rewritten history)." >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "Bypass requires 'git push --no-verify' and maintainer approval. See CONTRIBUTING.md, section \"Branches, commits and pull requests\"." >&2
fi
exit "$status"
